# Kakure Configuration
# Copy this file to .env and fill in your values

# Required for OpenAI translation backend
OPENAI_API_KEY=sk-...

# Required for DeepL translation backend
DEEPL_API_KEY=

# ASR backend: "faster-whisper" or "kotoba-whisper"
KAKURE_ASR_BACKEND=faster-whisper

# faster-whisper settings
KAKURE_WHISPER_MODEL=large-v3
KAKURE_WHISPER_DEVICE=cpu
KAKURE_WHISPER_COMPUTE_TYPE=int8

# kotoba-whisper settings (only used when KAKURE_ASR_BACKEND=kotoba-whisper)
KAKURE_KOTOBA_WHISPER_MODEL=kotoba-tech/kotoba-whisper-v2.0
KAKURE_KOTOBA_WHISPER_CHUNK_LENGTH_S=15

# Translation backend: "openai" or "deepl"
KAKURE_TRANSLATION_BACKEND=openai

# OpenAI model for translation
KAKURE_OPENAI_MODEL=gpt-4o-mini

# Chinese TTS voice (edge-tts backend)
KAKURE_CHINESE_VOICE=zh-CN-XiaoxiaoNeural

# TTS adjustments (edge-tts backend)
KAKURE_TTS_RATE=+0%
KAKURE_TTS_VOLUME=+0%
KAKURE_TTS_PITCH=+0Hz

# TTS backend: "edge-tts" or "indextts"
KAKURE_TTS_BACKEND=edge-tts

# IndexTTS settings (only used when KAKURE_TTS_BACKEND=indextts)
# Required: path to a 3-10 second reference audio file for voice cloning
KAKURE_INDEXTTS_REFERENCE_AUDIO=
# Optional: path to local model checkpoints (auto-downloads from HuggingFace if not set)
KAKURE_INDEXTTS_MODEL_DIR=
# Language for IndexTTS synthesis
KAKURE_INDEXTTS_LANGUAGE=zh

# Mixing mode: "dual", "overlay", "sequential", "whisper"
KAKURE_MIX_MODE=overlay

# Volume adjustments (dB, negative = quieter)
KAKURE_OVERLAY_VOLUME_DB=-6.0
KAKURE_WHISPER_VOLUME_DB=-15.0

# Gap between JP and CN in sequential mode (milliseconds)
KAKURE_SEQUENTIAL_GAP_MS=800

# Vocal separation (Demucs) - splits background from vocals for cleaner mixing
KAKURE_SEPARATE_VOCALS=false
KAKURE_DEMUCS_MODEL=htdemucs
KAKURE_DEMUCS_DEVICE=cpu
# Volume for original vocals when separated (dB, negative = quieter)
KAKURE_VOCALS_VOLUME_DB=-6.0
# Volume for background when separated (dB)
KAKURE_BACKGROUND_VOLUME_DB=0.0

# Output settings
KAKURE_OUTPUT_FORMAT=mp3
KAKURE_OUTPUT_BITRATE=192k
KAKURE_OUTPUT_SAMPLE_RATE=44100