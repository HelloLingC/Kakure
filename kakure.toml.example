# Kakure Configuration
# Copy this file to kakure.toml and edit as needed.
# Settings can also be changed in the web UI (Settings tab).

# Required for OpenAI translation backend
openai_api_key = ""

# ASR backend: "faster-whisper" or "kotoba-whisper"
asr_backend = "faster-whisper"

# faster-whisper settings
whisper_model = "large-v3"
whisper_device = "cpu"
whisper_compute_type = "int8"
whisper_language = "ja"
whisper_beam_size = 5
whisper_vad_filter = true

# kotoba-whisper settings (only used when asr_backend = "kotoba-whisper")
kotoba_whisper_model = "kotoba-tech/kotoba-whisper-v2.0"
kotoba_whisper_chunk_length_s = 15

# Translation backend
translation_backend = "openai"

# OpenAI-compatible API settings (defaults target DeepSeek)
openai_model = "deepseek-v4-flash"
# Optional: custom OpenAI-compatible API base URL
openai_base_url = "https://api.deepseek.com"

# Optional: custom translation system prompt (OpenAI backend only).
# Leave empty to use the built-in ASMR translation prompt.
# Setting this lets you use an NSFW/custom prompt without uploading it to GitHub
# (kakure.toml is gitignored).
translation_prompt = ""

# Batch translation: number of segments translated per OpenAI API call.
# 1 = legacy per-segment (one request per segment).
# Higher values (e.g. 10) send multiple segments in one JSON-mode request,
# reducing round-trips and token overhead. Failed batches auto-fallback to
# per-segment translation for robustness.
translation_batch_size = 10

# Approximate per-batch input-token budget (chars * 1.2 estimate).
# A batch is split early if its cumulative estimate exceeds this, regardless
# of translation_batch_size. Default 8000 leaves headroom for system prompt +
# JSON output on gpt-4o-mini's 16k context.
translation_batch_token_limit = 8000

# Max concurrent translation API calls. 1 = sequential (legacy behavior).
# Higher values dispatch multiple batches in parallel for faster translation,
# but may hit provider rate limits. Set to 4 for a good speed/limit balance.
translation_max_concurrency = 4

# TTS backend: "edge-tts" or "indextts"
tts_backend = "edge-tts"

# Chinese TTS voice (edge-tts backend)
chinese_voice = "zh-CN-XiaoxiaoNeural"

# TTS adjustments (edge-tts backend)
tts_rate = "+0%"
tts_volume = "+0%"
tts_pitch = "+0Hz"

# IndexTTS settings (only used when tts_backend = "indextts")
# Required: path to a 3-10 second reference audio file for voice cloning
indextts_reference_audio = ""
# Optional: path to local model checkpoints (auto-downloads from HuggingFace if not set)
indextts_model_dir = ""
# Language for IndexTTS synthesis
indextts_language = "zh"

# Mixing mode: "dual", "overlay", "sequential", "whisper", "spatial"
mix_mode = "overlay"

# Volume adjustments (dB, negative = quieter)
overlay_volume_db = -6.0
whisper_volume_db = -15.0
# Cross-channel volume in spatial mode (dB, ~-10.5 = 30%)
spatial_cross_db = -10.5

# Gap between JP and CN in sequential mode (milliseconds)
sequential_gap_ms = 800

# Vocal separation (Demucs) - splits background from vocals for cleaner mixing
separate_vocals = false
demucs_model = "htdemucs"
demucs_device = "cpu"
# Volume for original vocals when separated (dB, negative = quieter)
vocals_volume_db = -6.0
# Volume for background when separated (dB)
background_volume_db = 0.0

# Output settings
output_format = "mp3"
output_bitrate = "192k"
output_sample_rate = 44100

# Temp directory for intermediate files (relative to the workspace where
# Kakure is launched)
temp_dir = "tmp"

# Directory for generated SRT subtitle files ({stem}_ja.srt, {stem}_zh.srt,
# {stem}_bilingual.srt). Leave empty to write in the same directory as the
# input file (temp_dir in the web UI, input file directory in the CLI).
srt_output_dir = ""

# Checkpoints - cache pipeline stage results (ASR, translation, TTS, vocal
# separation) keyed by input-file hash so re-running the same file skips
# already-completed stages (e.g. after a crash or a mix-settings tweak).
enable_checkpoints = true
# Directory for cached stage results. Leave empty for <temp_dir>/checkpoints.
checkpoint_dir = ""